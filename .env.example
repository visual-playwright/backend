PORT=5002

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=autoqa
DB_PORT=3306

# OpenCode Zen — Muse Spark 1.3 Free (Responses API, bukan chat-completions)
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_API_KEY=
ZEN_MODEL=muse-spark-1.3-contributor-free

# Opsional: fallback saat Zen 429
GEMINI_API_KEY=

BROWSER_HEADLESS=true
VIEWPORT_W=1280
VIEWPORT_H=720
TZ=Asia/Jakarta

# Urutan provider LLM vision: auto = opencode -> gemini -> pollinations
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash

# Provider utama: CLI OpenCode (free tier hanya jalan di dalam OpenCode)
OPENCODE_BIN=opencode
OPENCODE_DIR=/path/ke/webAutoQA/backend
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_AGENT=qa-vision
OPENCODE_CWD=/path/ke/visual-playwright

# Login web app (tunggal, tanpa logout)
ADMIN_USER=admin
ADMIN_PASS=ganti-dengan-password-kuat
JWT_SECRET=ganti-dengan-string-acak-panjang
